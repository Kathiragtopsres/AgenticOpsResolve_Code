{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "requestApproval",
  "x-opsresolve-kind": "write",
  "input": {
    "type": "object",
    "properties": {
      "caseId": {
        "type": "string"
      },
      "action": {
        "type": "string"
      },
      "amountUsd": {
        "type": "number"
      },
      "rationale": {
        "type": "string"
      },
      "idempotencyKey": {
        "type": "string"
      }
    },
    "required": [
      "caseId",
      "action",
      "rationale",
      "idempotencyKey"
    ]
  },
  "output": {
    "type": "object",
    "properties": {
      "approvalId": {
        "type": "string"
      },
      "code": {
        "type": "string",
        "pattern": "^\\d{4}$"
      },
      "expiresAt": {
        "type": "string",
        "format": "date-time"
      },
      "status": {
        "const": "PENDING"
      }
    }
  }
}
